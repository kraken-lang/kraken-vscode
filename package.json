{
  "name": "kraken-lang",
  "displayName": "Kraken Language Support",
  "description": "Syntax highlighting, snippets, and language features for the Kraken programming language",
  "version": "0.1.0",
  "publisher": "jamesgober",
  "author": {
    "name": "James Gober",
    "email": "code@jamesgober.dev"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters"
  ],
  "keywords": [
    "kraken",
    "systems programming",
    "compiled language",
    "performance"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kraken-lang/kraken.git",
    "directory": "editors/vscode"
  },
  "bugs": {
    "url": "https://github.com/kraken-lang/kraken/issues"
  },
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "kraken",
        "aliases": ["Kraken", "kraken"],
        "extensions": [".kraken", ".kk"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kraken",
        "scopeName": "source.kraken",
        "path": "./syntaxes/kraken.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "kraken",
        "path": "./snippets/kraken.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "^18.0.0",
    "typescript": "^5.0.0",
    "vsce": "^2.15.0"
  }
}