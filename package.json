{
  "name": "kraken-lang",
  "displayName": "Kraken Language Support",
  "description": "Syntax highlighting, snippets, and language features for the Kraken programming language",
  "version": "0.2.0",
  "publisher": "jamesgober",
  "author": {
    "name": "James Gober",
    "email": "code@jamesgober.dev"
  },
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "kraken",
    "systems programming",
    "compiled language",
    "performance",
    "syntax highlighting"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kraken-lang/kraken-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/kraken-lang/kraken-vscode/issues"
  },
  "homepage": "https://github.com/kraken-lang/kraken-vscode",
  "contributes": {
    "languages": [
      {
        "id": "kraken",
        "aliases": ["Kraken", "kraken"],
        "extensions": [".kr"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/file-icon.png",
          "dark": "./images/file-icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "kraken",
        "scopeName": "source.kraken",
        "path": "./syntaxes/kraken.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "kraken",
        "path": "./snippets/kraken.json"
      }
    ]
  },
  "scripts": {
    "package": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^2.24.0"
  }
}